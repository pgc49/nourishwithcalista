---
import { Image } from 'astro:assets';
import heroImg from '../assets/callie-hero.jpg';
import { MM_URL } from '../data/site';
---

<section class="wrap hero">
  <div>
    <h1>
      Hi, I'm Calista.<br />
      I help moms feel <em>like themselves</em> again.
    </h1>
    <p class="lede">
      You can call me Callie. Functional nutritional therapy practitioner, mama
      of two boys, and founder of Macros and Mamas. Real food, real numbers, and
      a plan that survives life with little kids.
    </p>
    <div class="cta">
      <a class="btn rose" href={MM_URL}>Explore Macros and Mamas</a>
      <a class="btn ghost" href="#about">Read my story</a>
    </div>
  </div>
  <div class="portrait">
    <Image
      src={heroImg}
      alt="Calista Chammas, functional nutritional therapy practitioner"
      widths={[400, 600, 800, 1200]}
      sizes="(max-width: 820px) 340px, 48vw"
      width={800}
      height={1000}
      fetchpriority="high"
      loading="eager"
    />
    <div class="tag">
      Founder, Macros and Mamas
      <span>8-week macro coaching for postpartum moms</span>
    </div>
  </div>
</section>
