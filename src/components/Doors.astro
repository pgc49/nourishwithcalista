---
import { BOOKING_MAILTO, MM_URL } from '../data/site';
---

<section class="section">
  <div class="wrap doors">
    <div class="door mamas">
      <h3>For mamas</h3>
      <p>
        Eight weeks with me. Ranges built by hand, real food, and a coach who
        answers.
      </p>
      <a class="btn rose" href={MM_URL}>Start with Macros and Mamas</a>
    </div>
    <div class="door teams">
      <h3>For companies</h3>
      <p>
        A talk or workshop your people will use. Wellness weeks, women's groups,
        whole-company sessions.
      </p>
      <a class="btn" href={BOOKING_MAILTO}>Book Callie</a>
    </div>
  </div>
</section>
